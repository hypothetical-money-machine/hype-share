SHAREPLAN_PORT=8788
SHAREPLAN_HOST=127.0.0.1
SHAREPLAN_PUBLIC_BASE_URL=http://127.0.0.1:8788
# Serve each site from its own origin at <id>.<suffix> (needs a wildcard DNS
# record and cert for *.<suffix>). Leave empty to serve everything under /s/:id/.
SHAREPLAN_SITE_HOST_SUFFIX=
SHAREPLAN_DATA_DIR=./data
SHAREPLAN_S3_ENDPOINT=http://127.0.0.1:9000
SHAREPLAN_S3_REGION=auto
SHAREPLAN_S3_BUCKET=shareplan
SHAREPLAN_S3_ACCESS_KEY=minioadmin
SHAREPLAN_S3_SECRET_KEY=minioadmin
SHAREPLAN_S3_FORCE_PATH_STYLE=true
SHAREPLAN_MAX_SITE_BYTES=52428800
SHAREPLAN_MAX_FILE_COUNT=200
SHAREPLAN_DEFAULT_TTL=
# Also signs in to /owner. Portal requires isolated site hosts and HTTPS (loopback HTTP allowed).
SHAREPLAN_ADMIN_TOKEN=dev-admin-token-change-me
# HMAC pepper for register / free-- IP rate limits. Required for POST /register.
SHAREPLAN_IP_HASH_PEPPER=dev-ip-pepper-change-me
# Trust CF-Connecting-IP / X-Forwarded-For (only when the process sits behind that proxy).
SHAREPLAN_TRUST_FORWARDED=false
SHAREPLAN_REGISTER_PER_DAY=10
# Max organization-token registers and org-admin key mints per organization per day.
SHAREPLAN_ORG_REGISTER_PER_DAY=100
# How many versions keep their files in S3, counting the live one: 2 keeps the
# live version plus the previous one, 1 keeps only the live version. Min 1.
SHAREPLAN_VERSION_RETENTION=2
# How often to delete expired sites, in seconds. 0 disables the sweeper.
SHAREPLAN_REAP_INTERVAL_SEC=300
# Optional WorkOS AuthKit account claiming. Set all three values to enable it.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Example: http://127.0.0.1:8788/v1/auth/workos/callback
WORKOS_REDIRECT_URI=

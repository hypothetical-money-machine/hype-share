# Copy this into your stack's environment. Do not commit the real values.
SHAREPLAN_PUBLIC_BASE_URL=https://share.example.com
# Sites are served at <id>.share.example.com; the base URL above is the API host.
SHAREPLAN_SITE_HOST_SUFFIX=share.example.com
# Also signs in to /owner. Portal requires isolated site hosts and HTTPS (loopback HTTP allowed).
SHAREPLAN_ADMIN_TOKEN=replace-with-a-long-random-secret
SHAREPLAN_IP_HASH_PEPPER=replace-with-a-long-random-secret
SHAREPLAN_TRUST_FORWARDED=true
SHAREPLAN_REGISTER_PER_DAY=10
# Max organization-token registers and org-admin key mints per organization per day.
SHAREPLAN_ORG_REGISTER_PER_DAY=100
MINIO_ROOT_USER=shareplan
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret

# Optional limits
SHAREPLAN_S3_REGION=auto
SHAREPLAN_S3_BUCKET=shareplan
SHAREPLAN_MAX_SITE_BYTES=52428800
SHAREPLAN_MAX_FILE_COUNT=200
SHAREPLAN_DEFAULT_TTL=
SHAREPLAN_VERSION_RETENTION=2
SHAREPLAN_REAP_INTERVAL_SEC=300

# WorkOS AuthKit account claiming. Leave all three empty to disable it.
# Example redirect: https://share.example.com/v1/auth/workos/callback
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
